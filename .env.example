# ─── Shiori Configuration ───
# Copy to .env and edit.

# Target repos (comma-separated, owner/name). Required.
# SHIORI_REPOS=masuda-masuo/shiori,astral-sh/ruff,golang/go

# Dev repos: code-indexed (tree-sitter chunks in DB).
# Reference repos (in SHIORI_REPOS but not here) are clone-only; use shiori_grep.
# SHIORI_DEV_REPOS=masuda-masuo/shiori,astral-sh/ruff

# Deprecated: use SHIORI_DEV_REPOS instead.
# When true and SHIORI_DEV_REPOS is unset, all repos are treated as dev.
# SHIORI_INDEX_CODE=true

# GitHub token (optional for public repos, required for private).
# GITHUB_TOKEN=ghp_xxx

# Pull-type sync interval (seconds). 0 = always pull on access.
# SHIORI_SYNC_INTERVAL_SECONDS=30

# Misc
# SHIORI_INDEX_BOT_LOGINS=mcp-launcher-masuda[bot]
# SHIORI_CODE_EXTENSIONS=.py,.js,.ts
# SHIORI_CODE_EXCLUDE_GLOBS=**/test_*, **/migrations/*

# 対象リポジトリ（カンマ区切りで複数可）
SHIORI_REPOS=owner/name

# --- GitHub 認証（いずれか。優先順: GitHub App > PAT > 匿名）---
# 非公開リポジトリ用 PAT（repo 読み取り権限）。公開リポジトリのみなら空でも可。
# mcp-launcher 等から短命トークンを注入する構成では .env には書かない
GITHUB_TOKEN=

# GitHub App 認証（短期 installation token。詳細設計/09）。
# 3 つ揃うと App を優先。秘密鍵は PATH かファイル本文（PEM）で渡す。
# ingest サービス（docker compose run --rm ingest）でのみ使用し、
# 常駐 app サービスには渡さない（鍵を MCP サーバーに届かせない）。
#GITHUB_APP_ID=123456
#GITHUB_APP_INSTALLATION_ID=7654321
# PATH を使う場合（compose の secrets でマウント。既定 /run/secrets/github_app_key）:
#GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github_app_key

# serve プロセス内のバックグラウンド自動同期間隔（秒）。0 で無効（既定）。
# この値が「索引の古さの上限」になる。差分同期は数秒で終わるため 900（15分）程度を推奨
#SHIORI_SYNC_INTERVAL_SECONDS=900

# 埋め込みモデルを変える場合（次元も合わせること。変更後は ingest --rebuild）
#EMBEDDING_MODEL=intfloat/multilingual-e5-small
#EMBEDDING_DIM=384

# =============================================================================
# Shiori Configuration
# Copy to .env and edit.
# =============================================================================


# ---------------------------------------------------------------------------
# [Required core]
# ---------------------------------------------------------------------------

# Target repos (comma-separated, owner/name). Required.
# SHIORI_REPOS=masuda-masuo/shiori,astral-sh/ruff,golang/go

# ---------------------------------------------------------------------------
# [Reference-repo settings]
# Applies to repos in SHIORI_REPOS but NOT in SHIORI_DEV_REPOS.
# Reference repos are clone-only: no code-tree chunking, no PR review fetch.
# ---------------------------------------------------------------------------

# Backfill seed for ref repos whose cursor is None.
# YYYY-MM-DD format. CLI --backfill-since overrides for all targets.
# Dev repos are never seeded by this env var (always full backfill).
# SHIORI_REF_BACKFILL_SINCE=2024-01-01

# ---------------------------------------------------------------------------
# [Dev-repo settings]
# Applies to repos in SHIORI_DEV_REPOS. Auth scope: these repos need
# write-scoped credentials (GitHub App / PAT with repo scope) if the
# agent creates issues/PRs; ingest itself is read-only.
# ---------------------------------------------------------------------------

# Dev repos: code-indexed (tree-sitter chunks in DB), PR reviews fetched.
# Reference repos (in SHIORI_REPOS but not here) are clone-only.
# SHIORI_DEV_REPOS=masuda-masuo/shiori,astral-sh/ruff

# (Deprecated) When true and SHIORI_DEV_REPOS is unset, all repos are dev.
# SHIORI_INDEX_CODE=true

# ---------------------------------------------------------------------------
# [Authentication]
# Token resolution order: TokenSocket > TokenCommand > PAT > anonymous.
# For public repos, no token is needed (anonymous works with stricter rate limits).
# ---------------------------------------------------------------------------

# Static PAT (simplest, least secure for production).
# GITHUB_TOKEN=ghp_xxx

# Unix socket path for on-demand token minting (recommended for containers).
# Host-side systemd service streams short-lived tokens; no private key enters
# the container.
# GITHUB_TOKEN_SOCKET=/run/shiori/mint.sock

# External command to obtain token (for host-side, no-Docker setups).
# GITHUB_TOKEN_COMMAND=mcp-token github

# ---------------------------------------------------------------------------
# [Circuit breaker] (issue #345)
# Stops retrying a repo after N consecutive failures. The backoff grows
# exponentially (base * 2^(failures-1)) up to a per-lane cap.
# ---------------------------------------------------------------------------

# Consecutive failures before the breaker engages. Unset, empty,
# unparseable, or negative values fall back to the default (5).
# Set to 0 to disable the circuit breaker entirely.
# SHIORI_CB_THRESHOLD=5

# Base backoff in seconds; the actual backoff is
# min(cap, base * 2^(failures-1)). Default 60.
# SHIORI_CB_BASE_BACKOFF=60

# Backoff cap (seconds) for dev repos (in SHIORI_DEV_REPOS), which sync on
# a ~15-minute cadence. Prevents exponential growth from parking a dev
# repo for days. Default 3600 (1 hour).
# SHIORI_CB_MAX_BACKOFF=3600

# Backoff cap (seconds) for reference repos (in SHIORI_REPOS but NOT in
# SHIORI_DEV_REPOS), which sync once a day. The dev cap is always below
# the daily cadence, so the breaker could never fire on that lane; this
# day-scale cap lets it (issue #371). Default 604800 (7 days).
# SHIORI_CB_REF_MAX_BACKOFF=604800

# ---------------------------------------------------------------------------
# [Misc]
# ---------------------------------------------------------------------------

# Pull-type sync debounce (seconds). 0 = always pull on access.
# Background auto-sync was removed in #236; this is a debounce for manual pulls.
# SHIORI_SYNC_INTERVAL_SECONDS=30

# Bot login allowlist (comma-separated). Bot comments are excluded from
# indexing by default; specific bots can be allowlisted here.
# SHIORI_INDEX_BOT_LOGINS=mcp-launcher-masuda[bot]

# Code file extensions (lowercase). Empty/unset = all.
# SHIORI_CODE_EXTENSIONS=.py,.js,.ts

# Code exclude globs (comma-separated).
# SHIORI_CODE_EXCLUDE_GLOBS=**/test_*, **/migrations/*

# Allow rebuild=True from MCP tool (default false).
# SHIORI_ALLOW_REBUILD=true

# ONNX INT8 model directory for CPU inference (issue #353). Build it with
# `docker compose run --rm app python scripts/build_onnx_model.py`, which
# writes into ./models (bind-mounted read-only into app/ingest containers).
# Requires the [onnx] extra (optimum/onnxruntime) to actually load; falls
# back to SentenceTransformer with a warning if the extra isn't installed.
# Set to an empty string ("") to explicitly disable ONNX even if a model is
# present at the default path -- this is what docker-compose.gpu.yml does
# for the ingest service, so GPU runs keep using SentenceTransformer/CUDA.
# SHIORI_ONNX_MODEL_PATH=/models/onnx/e5-small-int8

# Fetch-phase concurrency cap. Max number of repos fetched simultaneously.
# Default 4. Set higher for more parallelism (may hit GitHub rate limits),
# set lower to reduce API contention.
# SHIORI_FETCH_CONCURRENCY=4

# Pending-work volume that switches an ingest/index run to the bulk path
# (batched embedding via ChunkBuffer) -- issue #376. When the number of
# not-yet-indexed items (indexed_at IS NULL or stale) across the targeted
# repos is at least this many, the run batches instead of embedding one
# item at a time. Only the pending count is read: already-indexed items are
# never discarded, truncated, or re-fetched. Unset, empty, unparseable, or
# non-positive values fall back to the default (10000).
# SHIORI_BULK_PENDING_THRESHOLD=10000

# Maximum *working* time (seconds) one index run may spend before stopping
# at a safe boundary -- between repos, and inside a repo at each 200-item
# issue batch -- issue #377. The budget runs on time.monotonic(), so
# machine-suspend time does NOT consume it. An exhausted budget is a normal
# outcome: the run stops, logs, records per-repo progress (sync_runs
# pending_count / last_progress_at) and exits 0; the next run resumes where
# it left off via indexed_at. The remaining work and liveness are visible
# via shiori_status. Unset, empty, unparseable, or non-positive means
# unbounded (the default -- nothing changes unless you set this).
# Example: 3600 = stop after one hour of actual work.
# SHIORI_INGEST_TIME_BUDGET=3600

# Root log level (case-insensitive): DEBUG/INFO/WARNING/ERROR/CRITICAL.
# Default INFO. Per-file "indexed ..." lines are DEBUG; set SHIORI_LOG_LEVEL=DEBUG
# to see them. Unset/empty/unrecognised values fall back to INFO (never crash).
# SHIORI_LOG_LEVEL=INFO

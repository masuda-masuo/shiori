[Unit]
Description=shiori mint socket mount reconciliation timer (shiori #461)
Documentation=https://github.com/masuda-masuo/shiori
# Periodic metadata check (~120s); does not mint tokens or refresh credentials.

[Timer]
OnActiveSec=10s
OnUnitActiveSec=2m
AccuracySec=10s

[Install]
WantedBy=timers.target
